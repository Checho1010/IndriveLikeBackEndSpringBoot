#spring.application.name=apirest
server:
  port: 3000
  #address: 192.168.100.78 # Esta es mi IPv4
  address: 0.0.0.0

spring:
  application:
    name: apirest

  datasource:
    url: jdbc:mysql://localhost:3306/udemy_delivery?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: USUARIO
    password: CLAVE
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        #dialect: org.hibernate.dialect.MySQLDialect
        dialect: org.hibernate.spatial.dialect.mysql.MySQLSpatialDialect

socket:
  host: 0.0.0.0
  port: 9092

google:
  api:
    key: KEY_DE_GOOGLE